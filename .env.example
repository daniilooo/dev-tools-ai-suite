# Variáveis de ambiente da Dev Tools AI Suite (somente nomes e valores não sensíveis).
# Nunca coloque segredos neste arquivo. O segredo de autenticação local é gerado na instalação
# e armazenado em <DEVTOOLS_DATA_DIR> com permissão 0600.

# Endereço de bind. Padrão obrigatório no MVP: 127.0.0.1 (exposição na rede exige gate humano).
DEVTOOLS_HOST=127.0.0.1
DEVTOOLS_PORT=4317

# Diretório de dados local (config, SQLite, índices, logs).
DEVTOOLS_DATA_DIR=~/.dev-tools-ai-suite

# Nível de log: error | warn | info | debug
DEVTOOLS_LOG_LEVEL=info

# Provedor de embeddings local: onnx | ollama | disabled
DEVTOOLS_EMBEDDING_PROVIDER=onnx
OLLAMA_HOST=http://127.0.0.1:11434

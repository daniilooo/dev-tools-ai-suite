{
  "name": "devtools-ai-suite",
  "version": "0.0.0",
  "description": "Camada local-first de integração, observabilidade e conhecimento para desenvolvimento assistido por IA.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniilooo/dev-tools-ai-suite.git",
    "directory": "apps/server"
  },
  "type": "module",
  "bin": {
    "devtools": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/copy-web.mjs",
    "dev": "tsx watch src/cli.ts start --no-open",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "fastify": "5.12.7"
  },
  "devDependencies": {
    "@devtools/shared": "workspace:*",
    "@types/better-sqlite3": "9.6.0",
    "tsx": "4.23.15"
  }
}
